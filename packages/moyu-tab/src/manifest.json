{
  "manifest_version": 3,
  "name": "闲页",
  "version": "0.2.0",
  "description": "清闲的新标签页摸鱼面板",

  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },

  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "favicon",
    "power",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://api.i-meto.com/*",
    "https://timor.tech/*",
    "https://*.music.126.net/*",
    "https://weread.qq.com/*",
    "https://i.weread.qq.com/*",
    "https://open.er-api.com/*",
    "https://aihot.virxact.com/*",
    "https://typhoon.slt.zj.gov.cn/*"
  ]
}