{
  "name": "@extensions/reading-community",
  "version": "0.1.0",
  "description": "书搭子 — 浏览器随手记笔记的读书搭子",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:bundle && npm run build:copy",
    "build:bundle": "node scripts/build-bundle.cjs",
    "build:copy": "node scripts/copy-assets.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}